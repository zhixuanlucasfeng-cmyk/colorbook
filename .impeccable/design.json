  "narrative": {
    "northStar": "漫画印刷感",
    "overview": "以用户确认的「漫画印刷感：黑白、朱红、粗线条，涂色区安静清楚」为视觉准则。首页借重黑刊头、粗字、锯齿纸边和朱红标记形成印刷品的力度；进入工作台后，装饰退到画布之外，照片本身和数字格子成为主角。\n\n界面文案使用中文，正文保持系统字体的清楚易读。漫画气质来自排版与线条，不依赖角色插画。设计参考已确认的 `.impeccable/approved-concept.png`；本文记录当前 PWA 与微信小程序的实现，未将样式代码检查视作微信原生环境的视觉验收。",
    "keyCharacteristics": [
      "重黑刊头与少量朱红形成印刷感。",
      "作品缩略图保留像素边缘，工具和画布保持清楚。",
      "近直角、实线边框、少量硬阴影；正文使用系统中文字体。"
    ],
    "rules": [
      {
        "name": "The Canvas Clarity Rule",
        "body": "画布底色保持中性，格内数字使用墨黑；色板编号依据颜色对比度选纯黑或纯白，不能统一染成品牌红。",
        "section": "colors"
      },
      {
        "name": "The Readable Body Rule",
        "body": "展示字体只承担品牌名；长文、工具、数字提示继续使用清楚的系统字体。",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "日常操作保持平面；硬阴影只沿用已实现的完成提示，不扩散到普通作品卡片。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 将朱红用于导入、作品进度和关键标记，工作台进度与工具选中使用墨黑。",
      "Do 保留中性灰画布背景、清楚的格内数字和基于对比度的色板编号。",
      "Do 为按钮保留至少 44px 的主要触控区域，并照顾设备安全区。",
      "Do 新增品牌标题字符时重新生成本地字体子集；正文继续使用系统字体。"
    ],
    "donts": [
      "Don't 把作品的任意颜色当作全局品牌色。",
      "Don't 用漫画装饰遮挡画布、数字、色板或手势操作。",
      "Don't 把全局正文改成展示字体或像素字体。",
      "Don't 给普通卡片添加柔和浮层阴影、胶囊轮廓或多色渐变。"
    ]
  }
}
