page { height: 100%; }
.play { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }

.top { display: flex; align-items: center; gap: 12px; padding: 8px 16px; }
.bar { flex: 1; display: flex; gap: 2px; height: 12px; padding: 2px; border: 3px solid var(--ink); background: var(--card); }
.seg { flex: 1; background: var(--paper-deep); }
.seg.on { background: var(--mint); }
.count { font-size: 12px; line-height: 16px; color: var(--muted); font-variant-numeric: tabular-nums; }

.stage-wrap { flex: 1; position: relative; border-top: 3px solid var(--ink); border-bottom: 3px solid var(--ink); background: var(--canvas); }
.stage { width: 100%; height: 100%; display: block; }

.panel { position: absolute; left: 12px; right: 12px; bottom: 12px; background: var(--card); border: 3px solid var(--ink);
  box-shadow: 0 6px 0 var(--ink); padding: 12px; }
.swatch { height: 40px; line-height: 40px; text-align: center; font-size: 16px; border: 3px solid var(--ink); margin-bottom: 8px; }
.hsl { display: flex; align-items: center; font-size: 12px; color: var(--muted); }
.sl { flex: 1; margin: 8px 0 8px 12px; }

.tools { display: flex; align-items: center; gap: 10px; padding: 12px 16px 6px; }
.tool { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; box-sizing: border-box;
  background: var(--card); border: 3px solid var(--ink); box-shadow: 0 4px 0 var(--ink); transition: transform .08s, box-shadow .08s; }
.tool.on { background: var(--ink); }
.tool image { width: 20px; height: 20px; }
.tool.small { width: 36px; height: 36px; }
.tool.small image { width: 14px; height: 14px; }
.size { margin-left: auto; display: flex; align-items: center; gap: 8px; }
.size-num { min-width: 40px; text-align: center; font-size: 24px; line-height: 28px; color: var(--ink); font-variant-numeric: tabular-nums; }
.size-num text { font-size: 12px; color: var(--muted); margin-left: 2px; }
.tool-name { margin-left: auto; font-size: 12px; color: var(--muted); }
.pressed { transform: translateY(3px); box-shadow: 0 1px 0 var(--ink) !important; }

.palette { white-space: nowrap; }
.palette-row { display: inline-flex; gap: 10px; padding: 12px 16px calc(14px + env(safe-area-inset-bottom)); }
.sw { width: 48px; height: 48px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
  border: 3px solid var(--ink); box-shadow: 0 4px 0 var(--ink); font-size: 16px; box-sizing: border-box;
  transition: transform .14s cubic-bezier(.16, 1, .3, 1), box-shadow .14s; }
.sw.on { transform: translateY(-6px); box-shadow: 0 10px 0 var(--ink); }
.sw.done { opacity: .55; }
.tick { width: 20px; height: 20px; }
