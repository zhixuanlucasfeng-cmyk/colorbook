page { height: 100%; }
.play { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.save-line { display: flex; justify-content: space-between; padding: 8px 16px 0; font-size: 11px; color: var(--muted); }
.top { display: flex; align-items: center; gap: 12px; padding: 10px 16px 12px; }
.bar { flex: 1; display: flex; height: 7px; border: 1px solid var(--ink); background: var(--paper); }
.seg { flex: 1; }
.seg.on { background: var(--ink); }
.count { font-size: 13px; font-weight: 750; line-height: 18px; }
.stage-wrap { flex: 1; min-height: 0; position: relative; margin: 0 16px; border: 1px solid var(--ink); background: var(--canvas); }
.stage { width: 100%; height: 100%; display: block; }
.panel { position: absolute; left: 8px; right: 8px; bottom: 8px; background: var(--card); border: 2px solid var(--ink); padding: 12px; }
.swatch { height: 36px; line-height: 36px; text-align: center; font-size: 16px; border: 1px solid var(--ink); margin-bottom: 8px; }
.hsl { display: flex; align-items: center; font-size: 12px; color: var(--muted); }
.sl { flex: 1; margin: 8px 0 8px 12px; }
.tools { padding: 10px 16px 0; }
.tool-buttons { display: flex; gap: 8px; }
.tool { flex: 1; height: 44px; display: flex; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box; background: var(--card); border: 1px solid var(--ink); border-radius: 2px; font-size: 14px; font-weight: 650; }
.tool.on { background: var(--ink); color: var(--paper); }
.tool image { width: 18px; height: 18px; }
.tool.small { flex: none; width: 44px; height: 40px; border: 0; background: transparent; }
.tool.small image { width: 14px; height: 14px; }
.size { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 8px; padding: 0 12px; min-height: 44px; border: 1px solid var(--paper-deep); }
.size-label { font-size: 13px; color: var(--muted); }
.size-num { min-width: 48px; text-align: center; font-size: 20px; font-weight: 750; }
.size-num text { font-size: 12px; margin-left: 3px; }
.tool-name { height: 44px; line-height: 44px; text-align: center; font-size: 12px; color: var(--muted); margin-top: 8px; }
.pressed { opacity: .75; }
.palette-heading { padding: 12px 16px 0; font-size: 13px; font-weight: 650; }
.palette { white-space: nowrap; flex-shrink: 0; }
.palette-row { display: inline-flex; gap: 12px; padding: 12px 20px calc(20px + env(safe-area-inset-bottom)); }
.sw { position: relative; width: 48px; height: 56px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid var(--ink); border-radius: 2px; font-size: 18px; font-weight: 750; box-sizing: border-box; }
.sw.on { outline: 2px solid var(--ink); outline-offset: 3px; }
.sw.on::after { content: ""; position: absolute; bottom: -13px; left: 18px; border-left: 5px solid transparent; border-right: 5px solid transparent; border-bottom: 6px solid var(--ink); }
.tick { width: 18px; height: 18px; }
